<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a"
    tools:context=".ui.MainActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AAudacitee Pro"
        android:textColor="#ffffff"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_margin="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- File Info -->
    <TextView
        android:id="@+id/file_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No file loaded"
        android:textColor="#cccccc"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_margin="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_title" />

    <!-- Timeline/Waveform Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/waveform_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#2a2a2a"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/file_info"
        app:layout_constraintBottom_toTopOf="@+id/plugin_selector_container"
        app:layout_constraintHeight_percent="0.35">

        <ScrollView
            android:id="@+id/waveform_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="horizontal"
            android:padding="8dp">

            <com.example.audioapp.ui.TimelineView
                android:id="@+id/timeline_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="#333333" />

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <!-- Plugin Selector -->
    <androidx.cardview.widget.CardView
        android:id="@+id/plugin_selector_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#2a2a2a"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/plugin_controls_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plugin:"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:layout_marginEnd="12dp" />

            <Spinner
                android:id="@+id/plugin_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#ffffff"
                android:layout_marginEnd="12dp" />

            <Switch
                android:id="@+id/plugin_bypass_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bypass"
                android:textColor="#ffffff"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Plugin Controls Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/plugin_controls_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#2a2a2a"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/transport_controls"
        app:layout_constraintTop_toBottomOf="@+id/plugin_selector_container"
        app:layout_constraintHeight_percent="0.3">

        <FrameLayout
            android:id="@+id/plugin_content_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <!-- Default EQ View -->
            <ScrollView
                android:id="@+id/eq_controls_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/eq_controls_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- EQ controls will be added dynamically -->

                </LinearLayout>

            </ScrollView>

            <!-- Placeholder for other plugin views -->
            <TextView
                android:id="@+id/plugin_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Select a plugin to see controls"
                android:textColor="#888888"
                android:textSize="16sp"
                android:gravity="center"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- Transport Controls -->
    <androidx.cardview.widget.CardView
        android:id="@+id/transport_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#333333"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Time display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=" / "
                    android:textColor="#cccccc"
                    android:textSize="14sp"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Progress bar -->
            <SeekBar
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:progressTint="#2196F3"
                android:thumbTint="#2196F3" />

            <!-- Control buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/button_load_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="Load"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#ffffff" />

                <Button
                    android:id="@+id/button_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="▶"
                    android:backgroundTint="#2196F3"
                    android:textColor="#ffffff" />

                <Button
                    android:id="@+id/button_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="⏸"
                    android:backgroundTint="#FF9800"
                    android:textColor="#ffffff" />

                <Button
                    android:id="@+id/button_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="⏹"
                    android:backgroundTint="#F44336"
                    android:textColor="#ffffff" />

                <Button
                    android:id="@+id/button_export"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:text="Export"
                    android:backgroundTint="#9C27B0"
                    android:textColor="#ffffff" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
